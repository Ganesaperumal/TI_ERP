{
  "name": "ti-erp-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TI-ERP: Enterprise Supermarket & Hypermarket Retail Operating System (Model-B Local LAN + Cloud)",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @ti-erp/database prisma generate",
    "db:validate": "pnpm --filter @ti-erp/database prisma validate",
    "db:push": "pnpm --filter @ti-erp/database prisma db push",
    "db:seed": "pnpm --filter @ti-erp/database run seed"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.6.3"
  }
}
