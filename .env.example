# TI-ERP Master Environment Configuration

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://tierp:tierp_secure_pass@localhost:5432/tierp_db?schema=public"

# Redis Cache & LAN Hold-Bill Pub/Sub
REDIS_URL="redis://localhost:6379"

# Node & API Server
PORT=4000
NODE_ENV="development"
JWT_SECRET="tierp_super_secret_jwt_token_change_in_production"

# Store Topology Mode: SINGLE_STORE or MULTI_BRANCH
TOPOLOGY_MODE="SINGLE_STORE"
STORE_ROLE="LOCAL_STORE" # or CLOUD_HO

# Hardware Bridge Settings
HARDWARE_BRIDGE_PORT=8089
ESC_POS_PRINTER_IP="192.168.1.200"
ESC_POS_PRINTER_PORT=9100
WEIGHING_SCALE_PORT="/dev/ttyUSB0"
WEIGHING_SCALE_BAUD=9600

# BYOK AI Configuration (OpenAI, Gemini, Claude, Ollama)
AI_DEFAULT_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
OLLAMA_BASE_URL="http://localhost:11434"

# Communication Gateways
WHATSAPP_API_TOKEN="your-whatsapp-cloud-api-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-id"
